{
  "target": {
    "path": "deployment/borq",
    "namespace": "borq-system"
  },
  "feature": {
    "network": {
      "incoming": {
        "mode": "steal",
        "ports": [
          7833
        ],
        "port_mapping": [
          [
            27833,
            7833
          ]
        ]
      },
      "outgoing": {
        "ignore_localhost": true
      },
      "dns": true
    }
  },
  "agent": {
    "namespace": "borq-system",
    "privileged": true,
    "ttl": 120,
    "startup_timeout": 120
  }
}