{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "borq-installer",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "routes": [
    { "pattern": "install.borq.io", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
